{
  "name": "tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "hash-password": "pnpm --filter @tracker/api hash-password",
    "db:migrate": "pnpm --filter @tracker/api db:migrate",
    "db:deploy": "pnpm --filter @tracker/api db:deploy",
    "db:seed": "pnpm --filter @tracker/api db:seed",
    "seed:check": "pnpm --filter @tracker/api seed:check",
    "targets:check": "pnpm --filter @tracker/api targets:check",
    "diary:check": "pnpm --filter @tracker/api diary:check",
    "weight:check": "pnpm --filter @tracker/api weight:check",
    "workout:check": "pnpm --filter @tracker/api workout:check",
    "db:studio": "pnpm --filter @tracker/api db:studio"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@prisma/client", "@prisma/engines", "esbuild", "prisma"]
  }
}
