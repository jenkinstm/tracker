# Скопируй в .env и заполни. Файл .env в git не попадает.
#
# Значения, где встречается $, пиши в ОДИНАРНЫХ КАВЫЧКАХ. Docker Compose
# интерполирует этот файл, и хеш вида $argon2id$v=19$m=... без кавычек
# приезжает в контейнер выпотрошенным. Скрипт hash-password делает это сам.

# База данных
DATABASE_URL=postgresql://tracker:CHANGEME@db:5432/tracker
POSTGRES_USER=tracker
POSTGRES_PASSWORD=CHANGEME
POSTGRES_DB=tracker

# Аутентификация
# Хеш пароля argon2id: pnpm hash-password. Сам пароль нигде не хранится.
# SESSION_SECRET — 32 случайных байта в base64, тот же скрипт сгенерирует.
AUTH_PASSWORD_HASH=
SESSION_SECRET=

# Web Push (VAPID). Ключи генерируются командой: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@profkosm.ru

# Open Food Facts требует осмысленный User-Agent
OFF_USER_AGENT=fit.profkosm.ru - personal tracker

# Прочее
NODE_ENV=development
PORT=3000
TZ=Europe/Moscow
PUBLIC_URL=https://fit.profkosm.ru
# true только за обратным прокси (Caddy). В деве false: иначе любой клиент
# подделает X-Forwarded-For и обойдёт лимит попыток входа.
TRUST_PROXY=false
