# ---- Приложение ----
APP_ENV=development
SECRET_KEY=change-me-32-bytes-min
BASE_URL=http://localhost:3000

# ---- Postgres ----
POSTGRES_USER=rankpulse
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rankpulse
DATABASE_URL=postgresql+asyncpg://rankpulse:change-me@postgres:5432/rankpulse

# ---- Redis / Celery ----
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---- Yandex Search API v2 (AI Studio): И позиции, И Вордстат ----
# Один ключ сервисного аккаунта на оба сервиса. Роль: search-api.executor
YANDEX_SEARCH_API_KEY=
YANDEX_CLOUD_FOLDER_ID=
YANDEX_WORDSTAT_RPS=5                      # квота YC ~5-10 rps, при превышении 429
YANDEX_WORDSTAT_PRICE_PER_1000_KOPECKS=10000   # GetTop / GetDynamics: 100 руб / 1000
YANDEX_WORDSTAT_NUM_PHRASES=100            # цена не зависит от значения; берём с запасом
YANDEX_WORDSTAT_FIX_TYPO=true
YANDEX_WORDSTAT_FILTER_MODE=moderate

# ---- XMLRiver (позиции Google + Яндекс) ----
XMLRIVER_USER=
XMLRIVER_KEY=
XMLRIVER_PRICE_PER_1000_KOPECKS=2500   # тариф Базовый: 25 руб / 1000

# ---- Режим поисковых запросов Search API (позиции) ----
YANDEX_SEARCH_API_MODE=deferred        # sync в 16 раз дороже
SYNC_MAX_KEYWORDS=100                  # выше порога синхронный режим запрещён
DEFERRED_RESULT_TTL_HOURS=12           # ответ удаляется навсегда, опрос обязан успеть
DEFERRED_BATCH_SIZE=5000               # пачка должна вычерпываться сильно быстрее TTL
DEFERRED_POLL_INTERVAL_SECONDS=60      # первый опрос не раньше чем через 5 минут
YANDEX_SEARCH_DEPTH=100                # глубже не ходим        # deferred | sync — sync в 16 раз дороже
YANDEX_SEARCH_PRICE_PER_1000_KOPECKS=3050

# ---- DataForSEO (опционально, Google вне РФ) ----
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_MODE=standard               # standard | priority | live

# ---- Лимиты и защита от перерасхода ----
MONTHLY_REQUEST_LIMIT=100000
MONTHLY_BUDGET_KOPECKS=500000          # 5000 руб, при превышении задачи не стартуют

# ---- Наблюдаемость ----
SENTRY_DSN=
LOG_LEVEL=INFO

# ---- Выбор провайдера ----
# mock — детерминированная заглушка для локальной разработки без ключей и без денег.
# yandex — боевой Yandex Search API v2 (нужны YANDEX_SEARCH_API_KEY и YANDEX_CLOUD_FOLDER_ID).
SERP_PROVIDER=mock
WORDSTAT_PROVIDER=mock

# ---- Аутентификация ----
ACCESS_TOKEN_TTL_MINUTES=43200
CORS_ORIGINS=http://localhost:3000

# ---- Фронтенд ----
NEXT_PUBLIC_API_URL=http://localhost:8000
