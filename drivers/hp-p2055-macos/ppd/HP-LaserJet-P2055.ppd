*NickName: "HP LaserJet P2055, rastertop2055"
*PCFileName: "HPP2055.PPD"
*PSVersion: "(3010.000) 0"
*LanguageLevel: "3"
*ColorDevice: False
*DefaultColorSpace: Gray
*FileSystem: False
*Throughput: "33"
*LandscapeOrientation: Plus90
*VariablePaperSize: False
*TTRasterizer: Type42
*cupsVersion: 2.4
*cupsModelNumber: 2055
*cupsManualCopies: False
*cupsFilter2: "application/vnd.cups-raster application/vnd.hp-pcl 50 rastertop2055"

