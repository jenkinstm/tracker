    "db:seed": "tsx src/seed/index.ts",
    "seed:check": "tsx scripts/check-seed.ts",
    "targets:check": "tsx scripts/check-targets.ts",
    "diary:check": "tsx scripts/check-diary.ts",
    "weight:check": "tsx scripts/check-weight.ts",
