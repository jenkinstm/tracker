    "@node-rs/argon2": "^2.0.0",
    "@prisma/client": "^6.0.0",
    "@tracker/shared": "workspace:*",
    "fastify": "^5.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prisma": "^6.0.0",
