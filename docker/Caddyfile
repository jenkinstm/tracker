# Caddy: HTTPS через Let's Encrypt автоматически, конфиг в несколько строк.
#
# Статику и API отдаёт один контейнер app: Caddy не видит содержимое его
# образа, и гонять `dist` через общий том ради разделения не стоит.
# На Caddy остаются TLS, сжатие и заголовки безопасности.
#
# Домен приходит из окружения — держать его здесь значило бы второй
# источник правды рядом с .env.

{$PUBLIC_DOMAIN} {
	encode zstd gzip

	reverse_proxy app:3000

	header {
		# HSTS на год. Откатить это в браузерах тяжело, поэтому включается
		# только когда сертификат уже выписан и домен точно постоянный.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		# Данные о здоровье наружу не уходят: сторонних источников нет вовсе.
		Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	# Имена собранных файлов содержат хеш — их можно кэшировать навсегда.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	@html path / /index.html
	header @html Cache-Control "no-cache"

	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
